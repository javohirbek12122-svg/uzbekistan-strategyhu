# --- Public (browser bundle) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: map tiles / geocoding key used by the address picker
NEXT_PUBLIC_MAPS_API_KEY=

# --- Server only (never expose to the browser) ---------------------------
# Supabase service role key: bypasses RLS, used by server actions and webhooks
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte key for AES-256-GCM encryption of console MFA secrets:
#   openssl rand -base64 32
CONSOLE_ENCRYPTION_KEY=

# Payme merchant credentials (Merchant API / JSON-RPC 2.0)
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Click merchant credentials (SHOP-API prepare/complete)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Shared secret for the SLA compensation cron endpoint
#   openssl rand -hex 32
CRON_SECRET=

# How many trusted proxies sit in front of the app. The console IP allow-list
# and the audit trail read the n-th `x-forwarded-for` value from the right, so
# client-supplied values cannot be spoofed. Vercel/most CDNs: 1
TRUSTED_PROXY_HOPS=1
