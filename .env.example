# Parkent E-Mart — muhit o'zgaruvchilari
# cp .env.example .env.local  va qiymatlarni to'ldiring

# --- Supabase (brauzer + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Sayt (brauzer) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPS_API_KEY=

# --- Supabase service role (FAQAT server, RLS ni chetlab o'tadi) ---
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Konsol MFA shifrlash kaliti (openssl rand -base64 32) ---
CONSOLE_ENCRYPTION_KEY=

# --- Payme Merchant API (faqat server) ---
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# --- Click SHOP-API (faqat server) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- SLA cron endpoint bearer token ---
CRON_SECRET=

# --- Oldindagi ishonchli proxy soni (Vercel: 1) ---
TRUSTED_PROXY_HOPS=1
