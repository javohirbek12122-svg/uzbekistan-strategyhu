# ── Public (exposed to the browser) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPS_API_KEY=

# ── Server-only (NEVER expose to the browser) ───────────────────────────────
# Required for admin console, order creation, payment callbacks, and audit logging.
# Found in Supabase Dashboard → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex key used to encrypt TOTP secrets in the admin_mfa table.
# Generate one with: openssl rand -hex 32
CONSOLE_ENCRYPTION_KEY=

# ── Payment providers (optional — only if accepting online payments) ────────
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ── Cron job auth ────────────────────────────────────────────────────────────
# Protects the /api/cron/sla endpoint. Set to a random string and pass as
# Authorization: Bearer <value> in your scheduler.
CRON_SECRET=

# ── Proxy trust (optional) ───────────────────────────────────────────────────
# Number of trusted proxy hops for correct client-IP extraction from
# X-Forwarded-For. Defaults to 1.
TRUSTED_PROXY_HOPS=1
